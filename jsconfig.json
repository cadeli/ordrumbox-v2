{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": false,
        "skipLibCheck": true,
        "maxNodeModuleJsDepth": 0
    },
    "include": ["src/**/*.js", "src/**/*.d.ts"],
    "exclude": ["node_modules", "dist", "release"]
}
